# Copy this file to .env in the same folder, then change the values you care about.
# Docker Compose reads .env when you run `docker compose up`. You do not rebuild
# application code to change these. Recreate the containers after an edit:
#
#   docker compose up -d
#
# Do not commit .env.

JWT_SECRET=change-me
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false

# Leave blank unless you want forgot-password, Report Bug, and stock-alert email.
# Without these, forgot-password and Report Bug show "Email services aren't available".
# Stock alerts still appear in the app.
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=

# Operator login. Change both before anyone else uses your deployment.
# These values are applied when that email is created for the first time.
# After the account exists, a new ADMIN_PASSWORD in .env does not replace the
# stored password. Change it from Edit Profile, or remove the mongo_data volume
# and start again if you still want the env value to be the password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# Leave blank to store product and profile images on the API disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
