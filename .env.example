# Copy to .env in this folder if you want to override Compose defaults.
# Docker Compose reads this file for ${VAR} substitution. The stack runs without it.

JWT_SECRET=change-me
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false

# Leave blank unless you want forgot-password and Report Bug email.
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=

# Leave blank to store product and profile images on the API disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
